# Local .terraform directories
.terraform/
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude .tfvars files containing environment-specific GCP project IDs
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore tfplan files
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Go build artifacts, private keys, and local environment-specific execution logs
bin/
*.key
*.pem
*.priv
*.log
.env
.env.*
/artifacts/
